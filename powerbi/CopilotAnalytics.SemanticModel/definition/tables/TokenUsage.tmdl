/// Copilot Studio token usage by agent/model (vw_copilotstudio_token_usage).
/// Populated only once token telemetry is flowing (see docs/token_telemetry_setup.md).
table TokenUsage
	lineageTag: 7c0d1e2f-1004-4000-8000-000000000401

	column usage_date
		dataType: dateTime
		formatString: yyyy-mm-dd
		lineageTag: 7c0d1e2f-1004-4000-8000-000000000411
		summarizeBy: none
		sourceColumn: usage_date

		annotation SummarizationSetBy = Automatic

	column agent_id
		dataType: string
		lineageTag: 7c0d1e2f-1004-4000-8000-000000000412
		summarizeBy: none
		sourceColumn: agent_id

		annotation SummarizationSetBy = Automatic

	column model
		dataType: string
		lineageTag: 7c0d1e2f-1004-4000-8000-000000000413
		summarizeBy: none
		sourceColumn: model

		annotation SummarizationSetBy = Automatic

	column conversations
		dataType: int64
		formatString: #,0
		lineageTag: 7c0d1e2f-1004-4000-8000-000000000414
		summarizeBy: sum
		sourceColumn: conversations

		annotation SummarizationSetBy = Automatic

	column prompt_tokens
		dataType: int64
		formatString: #,0
		lineageTag: 7c0d1e2f-1004-4000-8000-000000000415
		summarizeBy: sum
		sourceColumn: prompt_tokens

		annotation SummarizationSetBy = Automatic

	column completion_tokens
		dataType: int64
		formatString: #,0
		lineageTag: 7c0d1e2f-1004-4000-8000-000000000416
		summarizeBy: sum
		sourceColumn: completion_tokens

		annotation SummarizationSetBy = Automatic

	column total_tokens
		dataType: int64
		formatString: #,0
		lineageTag: 7c0d1e2f-1004-4000-8000-000000000417
		summarizeBy: sum
		sourceColumn: total_tokens

		annotation SummarizationSetBy = Automatic

	partition TokenUsage = m
		mode: import
		source =
				let
					Source = Sql.Database(ServerEndpoint, DatabaseName),
					data = Source{[Schema="dbo", Item="vw_copilotstudio_token_usage"]}[Data]
				in
					data

	annotation PBI_ResultType = Table
